<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:p2="clr-namespace:HtsLoom;assembly=Extensions"
                 xmlns:aeon="clr-namespace:Aeon.Acquisition;assembly=Aeon.Acquisition"
                 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
                 xmlns:p3="clr-namespace:System.Reactive.Linq;assembly=System.Reactive.Interfaces"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:aeon-env="clr-namespace:Aeon.Environment;assembly=Aeon.Environment"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:p4="clr-namespace:Feeder;assembly=Extensions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="p1:FeederInStateReward">
        <rx:Name>FeederInStateReward</rx:Name>
      </Expression>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="sys:Tuple(p2:FeederABCTransition,sys:String)">
        <rx:Name>PlayerTransition</rx:Name>
      </Expression>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="sys:Tuple(sys:Tuple(sys:Tuple(sys:Double,sys:Double),sys:String),p2:FeederName)">
        <rx:Name>FeederWheel</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>TaskConfiguration</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>FeederTask</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Key</Selector>
      </Expression>
      <Expression xsi:type="aeon:CreateGroup">
        <Name>FeederPlayer</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>PlayerId</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskConfiguration</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>FeederTask</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PlayerId</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Value" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Index">
              <Operand xsi:type="StringProperty">
                <Value>ScreenWest</Value>
              </Operand>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>MetaStates</Selector>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>MetaStates</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>StartState</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="InputMapping">
              <PropertyMappings>
                <Property Name="Value" Selector="Item2" />
              </PropertyMappings>
              <Selector>Item1</Selector>
            </Expression>
            <Expression xsi:type="Index">
              <Operand xsi:type="StringProperty">
                <Value>State_1</Value>
              </Operand>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>CurrentMetaState</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>ABCDStatePlayer</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="scg:Dictionary(sys:String,p2:ForagingState)">
                    <rx:Name>States</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:String">
                    <rx:Name>CurrentState</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:ReplaySubject" TypeArguments="p3:IGroupedObservable(p2:FeederName,harp:Timestamped(sys:Double))">
                    <rx:Name>InStateWheelDisplacement</rx:Name>
                    <rx:BufferSize xsi:nil="true" />
                  </Expression>
                  <Expression xsi:type="rx:ReplaySubject" TypeArguments="p3:IGroupedObservable(p2:FeederName,harp:Timestamped(sys:Double))">
                    <rx:Name>InStateWheelDeltaDisplacement</rx:Name>
                    <rx:BufferSize xsi:nil="true" />
                  </Expression>
                  <Expression xsi:type="rx:ReplaySubject" TypeArguments="p3:IGroupedObservable(p2:FeederName,harp:Timestamped(sys:Double))">
                    <rx:Name>InStateResetWheelDisplacement</rx:Name>
                    <rx:BufferSize xsi:nil="true" />
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping" />
                  <Expression xsi:type="rx:Defer">
                    <Name>StatePlayer</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(harp:Timestamped(sys:Double),p2:FeederName)">
                          <rx:Name>WheelDisplacement</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:GroupBy">
                          <rx:KeySelector>Item2</rx:KeySelector>
                          <rx:ElementSelector>Item1</rx:ElementSelector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>InStateWheelDisplacement</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(harp:Timestamped(sys:Double),p2:FeederName)">
                          <rx:Name>ResetWheelDisplacement</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:GroupBy">
                          <rx:KeySelector>Item2</rx:KeySelector>
                          <rx:ElementSelector>Item1</rx:ElementSelector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>InStateResetWheelDisplacement</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:GetCurrentDir" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>WorkingDir</Name>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(harp:Timestamped(sys:Double),p2:FeederName)">
                          <rx:Name>StateWheelDelta</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:GroupBy">
                          <rx:KeySelector>Item2</rx:KeySelector>
                          <rx:ElementSelector>Item1</rx:ElementSelector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>InStateWheelDeltaDisplacement</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>CurrentMetaState</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item1.StateFile</Selector>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>WorkingDir</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="Format">
                          <Format>{0}\{1}</Format>
                          <Selector>Item2,Item1</Selector>
                        </Expression>
                        <Expression xsi:type="rx:CreateObservable">
                          <Name>PLayMetaState</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:AsyncSubject">
                                <Name>FileName</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>FileName</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Path" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="io:ReadAllText">
                                  <io:Path>C:\ProjectAeon\aeon_exp_htsloom\src\ScreenWest_Rule.yaml</io:Path>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="p2:DeserializeFromYaml">
                                <p2:Type xsi:type="TypeMapping" TypeArguments="p2:ForagingController" />
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>States</Selector>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>States</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>StartState</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item2</Selector>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>CurrentState</Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="StateSwitchDelay" />
                              </Expression>
                              <Expression xsi:type="rx:Defer">
                                <Name>StatePlayer</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>CurrentState</Name>
                                    </Expression>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>States</Name>
                                    </Expression>
                                    <Expression xsi:type="Combinator">
                                      <Combinator xsi:type="rx:WithLatestFrom" />
                                    </Expression>
                                    <Expression xsi:type="ExternalizedMapping">
                                      <Property Name="StateSwitchDelay" />
                                    </Expression>
                                    <Expression xsi:type="rx:CreateObservable">
                                      <Name>PlayState</Name>
                                      <Workflow>
                                        <Nodes>
                                          <Expression xsi:type="WorkflowInput">
                                            <Name>Source1</Name>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Take">
                                              <rx:Count>1</rx:Count>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="InputMapping">
                                            <PropertyMappings>
                                              <Property Name="Value" Selector="Item1" />
                                            </PropertyMappings>
                                            <Selector>Item2</Selector>
                                          </Expression>
                                          <Expression xsi:type="Index">
                                            <Operand xsi:type="StringProperty">
                                              <Value>ScreenEast_State2</Value>
                                            </Operand>
                                          </Expression>
                                          <Expression xsi:type="rx:AsyncSubject">
                                            <Name>CurrentRunningState</Name>
                                          </Expression>
                                          <Expression xsi:type="SubscribeSubject">
                                            <Name>CurrentRunningState</Name>
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>PatchStates</Selector>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Merge" />
                                          </Expression>
                                          <Expression xsi:type="rx:SelectMany">
                                            <Name>WheelDisplacement</Name>
                                            <Workflow>
                                              <Nodes>
                                                <Expression xsi:type="WorkflowInput">
                                                  <Name>Source1</Name>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:Take">
                                                    <rx:Count>1</rx:Count>
                                                  </Combinator>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>Key</Selector>
                                                </Expression>
                                                <Expression xsi:type="rx:AsyncSubject">
                                                  <Name>FeederId</Name>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>Value</Selector>
                                                </Expression>
                                                <Expression xsi:type="rx:AsyncSubject">
                                                  <Name>PatchStateSettings</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>FeederWheelDisplacement</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>FeederId</Name>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:SubscribeWhen" />
                                                </Expression>
                                                <Expression xsi:type="IncludeWorkflow" Path="Extensions\MatchId.bonsai">
                                                  <IdSubjectToMatch>FeederId</IdSubjectToMatch>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:Merge" />
                                                </Expression>
                                                <Expression xsi:type="GroupWorkflow">
                                                  <Name>MaintenanceGain</Name>
                                                  <Workflow>
                                                    <Nodes>
                                                      <Expression xsi:type="SubscribeSubject">
                                                        <Name>EnvironmentState</Name>
                                                      </Expression>
                                                      <Expression xsi:type="MemberSelector">
                                                        <Selector>Value.Type</Selector>
                                                      </Expression>
                                                      <Expression xsi:type="Equal">
                                                        <Operand xsi:type="WorkflowProperty" TypeArguments="aeon-env:EnvironmentStateType">
                                                          <Value>Experiment</Value>
                                                        </Operand>
                                                      </Expression>
                                                      <Expression xsi:type="scr:ExpressionTransform">
                                                        <scr:Expression>it ? 1.0 : 0.0</scr:Expression>
                                                      </Expression>
                                                      <Expression xsi:type="WorkflowOutput" />
                                                    </Nodes>
                                                    <Edges>
                                                      <Edge From="0" To="1" Label="Source1" />
                                                      <Edge From="1" To="2" Label="Source1" />
                                                      <Edge From="2" To="3" Label="Source1" />
                                                      <Edge From="3" To="4" Label="Source1" />
                                                    </Edges>
                                                  </Workflow>
                                                </Expression>
                                                <Expression xsi:type="PropertyMapping">
                                                  <PropertyMappings>
                                                    <Property Name="Gain" />
                                                  </PropertyMappings>
                                                </Expression>
                                                <Expression xsi:type="harp:ConvertTimestamped">
                                                  <Workflow>
                                                    <Nodes>
                                                      <Expression xsi:type="WorkflowInput">
                                                        <Name>Source1</Name>
                                                      </Expression>
                                                      <Expression xsi:type="ExternalizedMapping">
                                                        <Property Name="Value" DisplayName="Gain" Description="A factor used to increase or decrease the speed of integration." />
                                                      </Expression>
                                                      <Expression xsi:type="Multiply">
                                                        <Operand xsi:type="DoubleProperty">
                                                          <Value>1</Value>
                                                        </Operand>
                                                      </Expression>
                                                      <Expression xsi:type="rx:Accumulate" />
                                                      <Expression xsi:type="WorkflowOutput" />
                                                    </Nodes>
                                                    <Edges>
                                                      <Edge From="0" To="2" Label="Source1" />
                                                      <Edge From="1" To="2" Label="Source2" />
                                                      <Edge From="2" To="3" Label="Source1" />
                                                      <Edge From="3" To="4" Label="Source1" />
                                                    </Edges>
                                                  </Workflow>
                                                </Expression>
                                                <Expression xsi:type="rx:PublishSubject">
                                                  <Name>WheelDisplacement</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>FeederId</Name>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:WithLatestFrom" />
                                                </Expression>
                                                <Expression xsi:type="WorkflowOutput" />
                                              </Nodes>
                                              <Edges>
                                                <Edge From="0" To="1" Label="Source1" />
                                                <Edge From="1" To="2" Label="Source1" />
                                                <Edge From="1" To="4" Label="Source1" />
                                                <Edge From="2" To="3" Label="Source1" />
                                                <Edge From="4" To="5" Label="Source1" />
                                                <Edge From="6" To="8" Label="Source1" />
                                                <Edge From="7" To="8" Label="Source2" />
                                                <Edge From="8" To="9" Label="Source1" />
                                                <Edge From="9" To="10" Label="Source1" />
                                                <Edge From="10" To="13" Label="Source1" />
                                                <Edge From="11" To="12" Label="Source1" />
                                                <Edge From="12" To="13" Label="Source2" />
                                                <Edge From="13" To="14" Label="Source1" />
                                                <Edge From="14" To="16" Label="Source1" />
                                                <Edge From="15" To="16" Label="Source2" />
                                                <Edge From="16" To="17" Label="Source1" />
                                              </Edges>
                                            </Workflow>
                                          </Expression>
                                          <Expression xsi:type="IncludeWorkflow" Path="Aeon.Environment:EnvironmentCondition.bonsai">
                                            <Value>Experiment</Value>
                                          </Expression>
                                          <Expression xsi:type="MulticastSubject">
                                            <Name>WheelDisplacement</Name>
                                          </Expression>
                                          <Expression xsi:type="SubscribeSubject">
                                            <Name>CurrentRunningState</Name>
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>PatchStates</Selector>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Merge" />
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>Key</Selector>
                                          </Expression>
                                          <Expression xsi:type="rx:SelectMany">
                                            <Name>WheelDeltaDisplacementGroup</Name>
                                            <Workflow>
                                              <Nodes>
                                                <Expression xsi:type="WorkflowInput">
                                                  <Name>Source1</Name>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:Take">
                                                    <rx:Count>1</rx:Count>
                                                  </Combinator>
                                                </Expression>
                                                <Expression xsi:type="rx:AsyncSubject">
                                                  <Name>FeederId</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>CurrentRunningState</Name>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>PatchStates</Selector>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>FeederId</Name>
                                                </Expression>
                                                <Expression xsi:type="PropertyMapping">
                                                  <PropertyMappings>
                                                    <Property Name="Value" />
                                                  </PropertyMappings>
                                                </Expression>
                                                <Expression xsi:type="Index">
                                                  <Operand xsi:type="WorkflowProperty" TypeArguments="p2:FeederName">
                                                    <Value>Feeder2</Value>
                                                  </Operand>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:Take">
                                                    <rx:Count>1</rx:Count>
                                                  </Combinator>
                                                </Expression>
                                                <Expression xsi:type="rx:AsyncSubject">
                                                  <Name>CurrentWheelState</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>FeederTimeSinceLastVisit</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>CurrentWheelState</Name>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>RewardRule.InactivityTimeout</Selector>
                                                </Expression>
                                                <Expression xsi:type="rx:Condition">
                                                  <Name>GreaterThanZero</Name>
                                                  <Workflow>
                                                    <Nodes>
                                                      <Expression xsi:type="WorkflowInput">
                                                        <Name>Source1</Name>
                                                      </Expression>
                                                      <Expression xsi:type="GreaterThan">
                                                        <Operand xsi:type="DoubleProperty">
                                                          <Value>0</Value>
                                                        </Operand>
                                                      </Expression>
                                                      <Expression xsi:type="WorkflowOutput" />
                                                    </Nodes>
                                                    <Edges>
                                                      <Edge From="0" To="1" Label="Source1" />
                                                      <Edge From="1" To="2" Label="Source1" />
                                                    </Edges>
                                                  </Workflow>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:SubscribeWhen" />
                                                </Expression>
                                                <Expression xsi:type="IncludeWorkflow" Path="Extensions\MatchId.bonsai">
                                                  <IdSubjectToMatch>FeederId</IdSubjectToMatch>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:Merge" />
                                                </Expression>
                                                <Expression xsi:type="IncludeWorkflow" Path="Aeon.Environment:EnvironmentCondition.bonsai">
                                                  <Value>Experiment</Value>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>Value</Selector>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
                                                  <Name>CurrentWheelState</Name>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>RewardRule.InactivityTimeout</Selector>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:WithLatestFrom" />
                                                </Expression>
                                                <Expression xsi:type="GreaterThan" />
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:DistinctUntilChanged" />
                                                </Expression>
                                                <Expression xsi:type="rx:Condition">
                                                  <Workflow>
                                                    <Nodes>
                                                      <Expression xsi:type="WorkflowInput">
                                                        <Name>Source1</Name>
                                                      </Expression>
                                                      <Expression xsi:type="WorkflowOutput" />
                                                    </Nodes>
                                                    <Edges>
                                                      <Edge From="0" To="1" Label="Source1" />
                                                    </Edges>
                                                  </Workflow>
                                                </Expression>
                                                <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:Timestamped(sys:Double)">
                                                  <rx:Name>WheelDisplacement</rx:Name>
                                                </Expression>
                                                <Expression xsi:type="Combinator">
                                                  <Combinator xsi:type="rx:WithLatestFrom" />
                                                </Expression>
                                                <Expression xsi:type="ExternalizedMapping">
                                                  <Property Name="MinimumDistThreshold" />
                                                </Expression>
                                                <Expression xsi:type="rx:Condition">
                                                  <Workflow>
                                                    <Nodes>
                                                      <Expression xsi:type="WorkflowInput">
                                                        <Name>Source1</Name>
                                                      </Expression>
                                                      <Expression xsi:type="MemberSelector">
                                                        <Selector>Item2.Value</Selector>
                                                      </Expression>
                                                      <Expression xsi:type="ExternalizedMapping">
                                                        <Property Name="Value" DisplayName="MinimumDistThreshold" />
                                                      </Expression>
                                                      <Expression xsi:type="GreaterThan">
                                                        <Operand xsi:type="DoubleProperty">
                                                          <Value>0.1</Value>
                                                        </Operand>
                                                      </Expression>
                                                      <Expression xsi:type="WorkflowOutput" />
                                                    </Nodes>
                                                    <Edges>
                                                      <Edge From="0" To="1" Label="Source1" />
                                                      <Edge From="1" To="3" Label="Source1" />
                                                      <Edge From="2" To="3" Label="Source2" />
                                                      <Edge From="3" To="4" Label="Source1" />
                                                    </Edges>
                                                  </Workflow>
                                                </Expression>
                                                <Expression xsi:type="MemberSelector">
                                                  <Selector>Item2</Selector>
                                                </Expression>
                                                <Expression xsi:type="harp:ConvertTimestamped">
                                                  <Workflow>
                                                    <Nodes>
                                                      <Expression xsi:type="WorkflowInput">
                                                        <Name>Source1</Name>
                                                      </Expression>
                                                      <Expression xsi:type="Multiply">
                                                        <Operand xsi:type="DoubleProperty">
                                                          <Value>-1</Value>
                                                        </Operand>
                                                      </Expression>
                                                      <Expression xsi:type="WorkflowOutput" />
                                                    </Nodes>
                                                    <Edges>
                                                      <Edge From="0" To="1" Label="Source1" />
                                                      <Edge From="1" To="2" Label="Source1" />
                                                    </Edges>
                                                  </Workflow>
                                                </Expression>
                                                <Expression xsi:type="rx:PublishSubject">
                                                  <Name>TriggerReset</Name>
                                                </Expression>
                                                <Expression xsi:type="SubscribeSubject">
